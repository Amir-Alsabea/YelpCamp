<% layout('layouts/plot') %>
<div id="cluster-map"></div>

<h1 class="mt-3" style="color: white;"><b>All CampGrounds</b></h1>

<style>
  .campground-thumb-wrap {
    height: 220px;
    overflow: hidden;
  }
  .campground-thumb {
    width: 100%;
    height: 140%;
    object-fit: cover;
    display: block;
  }
</style>

<ul>
    <%for(let i of camp) {%>
      <div class="card mb-3" style="color: white; background-color: rgba(0, 0, 0, 0.5);">
        <div class="row g-0">
            <div class="col-md-4 campground-thumb-wrap">
                <img class="campground-thumb" src="<%= i.image[0].url %>">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title"><%= i.title %></h5>
                    <p class="card-text"><%= i.desc %></p>
                    <small class="card-text"><%= i.location %></small>
                    <br>
                    <a href="/campG/<%= i._id %>" class="btn btn-outline-primary mt-3">More Details</a>
                </div>
            </div>
        </div>
      </div>
    <% }%>
</ul>

    <%- "<script>" %>
const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
const campgrounds = {
  type: "FeatureCollection",
  features: <%- JSON.stringify(
    camp.map(c => ({
      type: "Feature",
      geometry: c.geometry,
      properties: {
        popUpMarkup: `<a href="/campG/${c._id}">${c.title}</a> <p>${c.location}</p>`  
      }
}))
  ) %>
};
<%- "</script>" %>

<script src="/javaScript/clusterMap.js"></script>

  